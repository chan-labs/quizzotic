# Copy to .env and edit. Never commit .env.
# Hostnames must be DNS names you control, pointing at this machine.
QUIZZOTIC_HOST=quizzotic.example.com
POCKET_ID_HOST=auth.example.com
# "https" for real deployments. Use "http" only for a throwaway local trial.
URL_SCHEME=https

# Image tags. Pin QUIZZOTIC_TAG to a release (for example 0.1.0) in production.
QUIZZOTIC_TAG=latest
POCKET_ID_TAG=v1

# Generate with: openssl rand -base64 32
POCKET_ID_ENCRYPTION_KEY=change-me-generate-with-openssl-rand

# Secret of the quizzotic-web client, copied from Pocket ID (README step 3).
QUIZZOTIC_WEB_CLIENT_SECRET=
