[
  {
    "description": "Get an attempt\n\nReturns one of the caller's attempts. Agents with `attempts:read` may read.",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Attempt ID.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "attempts_get"
  },
  {
    "description": "List attempts\n\nLists the caller's attempts, oldest first (answer order), with cursor\npagination. Filters combine with AND. `problem` is a problem ID. `tag`\naccepts a tag ID, slug or alias and keeps attempts at problems that\ncarry it. `since` (inclusive) and `until` (exclusive) are RFC 3339\ntimestamps bounding `answered_at`. Agents with `attempts:read` may\nread.",
    "inputSchema": {
      "properties": {
        "cursor": {
          "description": "Opaque cursor from a previous page's `next_cursor`.",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "description": "Page size.",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "problem": {
          "description": "Only attempts at this problem ID.",
          "type": "string"
        },
        "since": {
          "description": "Only attempts answered at or after this RFC 3339 time.",
          "format": "date-time",
          "type": "string"
        },
        "tag": {
          "description": "Only attempts at problems carrying this tag, named by ID, slug or alias. An unknown tag is answered 422.",
          "type": "string"
        },
        "until": {
          "description": "Only attempts answered before this RFC 3339 time.",
          "format": "date-time",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "attempts_list"
  },
  {
    "description": "Create a problem\n\nCreates a problem and its first version. `status` is `draft` (the\ndefault) or `live`. The payload is validated against the type; every\nfailure is listed in `errors` of a 422 response.\n\nCheck for duplicates first (problems.similar), default to status draft so a human can review, and always tag the problem.",
    "inputSchema": {
      "properties": {
        "explanation": {
          "description": "Markdown, shown after the answer.",
          "type": "string"
        },
        "payload": {
          "description": "Type-specific payload; the shape follows `type`.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "Payload of an `mcq` problem. Needs at least 2 choices and at least 1\ncorrect id; when `multiple` is false, exactly 1 correct id. Every\n`correct` entry must be a choice id.\n",
              "properties": {
                "choices": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "text": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "text"
                    ],
                    "type": "object"
                  },
                  "minItems": 2,
                  "type": "array"
                },
                "correct": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "multiple": {
                  "default": false,
                  "type": "boolean"
                },
                "shuffle": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "choices",
                "correct"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Payload of a `cloze` problem. The problem prompt carries one\n`{{blank_id}}` marker per entry in `blanks`; markers and blanks match\none-to-one.\n",
              "properties": {
                "blanks": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "accepted": {
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array"
                      },
                      "case_sensitive": {
                        "default": false,
                        "type": "boolean"
                      },
                      "id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "max_edits": {
                        "default": 0,
                        "maximum": 3,
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "id",
                      "accepted"
                    ],
                    "type": "object"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "blanks"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Payload of an `open` problem.",
              "properties": {
                "reference_answer": {
                  "description": "Markdown. Must not be blank.",
                  "minLength": 1,
                  "type": "string"
                },
                "rubric": {
                  "description": "Optional key points, Markdown.",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "reference_answer"
              ],
              "type": "object"
            }
          ]
        },
        "prompt": {
          "description": "Markdown. For `cloze`, carries the `{{blank_id}}` markers.",
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "live"
          ],
          "type": "string"
        },
        "type": {
          "enum": [
            "mcq",
            "cloze",
            "open"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "prompt",
        "payload"
      ],
      "type": "object"
    },
    "name": "problems_create"
  },
  {
    "description": "Create up to 100 problems at once\n\nCreates every item (a problem plus its tags) in one transaction. The\nbatch holds 1 to 100 items. If any item is invalid, nothing is written\nand the 422 response lists the invalid fields of every bad item in\n`errors`, each `field` prefixed with the item's index, for example\n`items[3].payload.choices` or `items[0].tags[1]`. Items are validated\nlike `problems.create`; each tag is an ID, slug or alias of one of the\ncaller's tags (a merged tag resolves to the tag it was merged into).\nThe created problems are returned in request order. The request body\nis limited to 1 MiB.\n\nPrefer this over many problems.create calls when adding a set of problems. Default each item to status draft, tag every item, and send an Idempotency-Key so a retry cannot duplicate the batch.",
    "inputSchema": {
      "properties": {
        "items": {
          "items": {
            "additionalProperties": false,
            "description": "A `CreateProblemRequest` plus the tags to attach.",
            "properties": {
              "explanation": {
                "type": "string"
              },
              "payload": {
                "description": "Type-specific payload; the shape follows `type`.",
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "description": "Payload of an `mcq` problem. Needs at least 2 choices and at least 1\ncorrect id; when `multiple` is false, exactly 1 correct id. Every\n`correct` entry must be a choice id.\n",
                    "properties": {
                      "choices": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "text": {
                              "minLength": 1,
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "text"
                          ],
                          "type": "object"
                        },
                        "minItems": 2,
                        "type": "array"
                      },
                      "correct": {
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array",
                        "uniqueItems": true
                      },
                      "multiple": {
                        "default": false,
                        "type": "boolean"
                      },
                      "shuffle": {
                        "default": false,
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "choices",
                      "correct"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "Payload of a `cloze` problem. The problem prompt carries one\n`{{blank_id}}` marker per entry in `blanks`; markers and blanks match\none-to-one.\n",
                    "properties": {
                      "blanks": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "accepted": {
                              "items": {
                                "minLength": 1,
                                "type": "string"
                              },
                              "minItems": 1,
                              "type": "array"
                            },
                            "case_sensitive": {
                              "default": false,
                              "type": "boolean"
                            },
                            "id": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "max_edits": {
                              "default": 0,
                              "maximum": 3,
                              "minimum": 0,
                              "type": "integer"
                            }
                          },
                          "required": [
                            "id",
                            "accepted"
                          ],
                          "type": "object"
                        },
                        "minItems": 1,
                        "type": "array"
                      }
                    },
                    "required": [
                      "blanks"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "Payload of an `open` problem.",
                    "properties": {
                      "reference_answer": {
                        "description": "Markdown. Must not be blank.",
                        "minLength": 1,
                        "type": "string"
                      },
                      "rubric": {
                        "description": "Optional key points, Markdown.",
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "reference_answer"
                    ],
                    "type": "object"
                  }
                ]
              },
              "prompt": {
                "description": "Markdown. For `cloze`, carries the `{{blank_id}}` markers.",
                "minLength": 1,
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "status": {
                "default": "draft",
                "enum": [
                  "draft",
                  "live"
                ],
                "type": "string"
              },
              "tags": {
                "description": "Tag IDs, slugs or aliases to attach.",
                "items": {
                  "type": "string"
                },
                "maxItems": 50,
                "type": "array"
              },
              "type": {
                "enum": [
                  "mcq",
                  "cloze",
                  "open"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "prompt",
              "payload"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "name": "problems_createBatch"
  },
  {
    "description": "Edit a problem\n\nCreates a new version from the current one with the given fields\nreplaced; omitted fields keep their value. `change_kind` is required:\n`minor` (typo, wording) keeps the card; `major` (different correct\nanswer or question) starts a new card epoch, so earlier attempts stay\nattached to the old epoch. The merged result is validated like a\ncreate. Requires `If-Match` (412 when stale, 428 when missing).\n\nRead the problem first and send its ETag as If-Match. Use major only when the correct answer or the question itself changes.",
    "inputSchema": {
      "properties": {
        "change_kind": {
          "enum": [
            "minor",
            "major"
          ],
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "description": "Type-specific payload; the shape follows `type`.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "Payload of an `mcq` problem. Needs at least 2 choices and at least 1\ncorrect id; when `multiple` is false, exactly 1 correct id. Every\n`correct` entry must be a choice id.\n",
              "properties": {
                "choices": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "text": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "text"
                    ],
                    "type": "object"
                  },
                  "minItems": 2,
                  "type": "array"
                },
                "correct": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "multiple": {
                  "default": false,
                  "type": "boolean"
                },
                "shuffle": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "choices",
                "correct"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Payload of a `cloze` problem. The problem prompt carries one\n`{{blank_id}}` marker per entry in `blanks`; markers and blanks match\none-to-one.\n",
              "properties": {
                "blanks": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "accepted": {
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array"
                      },
                      "case_sensitive": {
                        "default": false,
                        "type": "boolean"
                      },
                      "id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "max_edits": {
                        "default": 0,
                        "maximum": 3,
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "id",
                      "accepted"
                    ],
                    "type": "object"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "blanks"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Payload of an `open` problem.",
              "properties": {
                "reference_answer": {
                  "description": "Markdown. Must not be blank.",
                  "minLength": 1,
                  "type": "string"
                },
                "rubric": {
                  "description": "Optional key points, Markdown.",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "reference_answer"
              ],
              "type": "object"
            }
          ]
        },
        "prompt": {
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "type": {
          "enum": [
            "mcq",
            "cloze",
            "open"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "change_kind"
      ],
      "type": "object"
    },
    "name": "problems_edit"
  },
  {
    "description": "Get a problem\n\nReturns the problem's current version. The default `full` view\nincludes correct answers, reference answer and rubric. `view=prompt`\nis what a client shows while answering: no correct answers, reference\nanswer, rubric or explanation, and MCQ choices shuffled when the\npayload says `shuffle`.",
    "inputSchema": {
      "properties": {
        "id": {
          "type": "string"
        },
        "view": {
          "default": "full",
          "description": "Which view to return. Defaults to `full`.",
          "enum": [
            "full",
            "prompt"
          ],
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "problems_get"
  },
  {
    "description": "List problems\n\nLists the caller's non-deleted problems, oldest first, with cursor\npagination. Filters combine with AND. `type` and `q` apply to the\nproblem's current version, `created_by_kind` to its creator. `q` is a\ncase-insensitive substring match over the prompt. `tag` accepts a tag\nslug or ID.",
    "inputSchema": {
      "properties": {
        "created_by_kind": {
          "description": "Only problems created by this kind of actor.",
          "enum": [
            "human",
            "agent",
            "system"
          ],
          "type": "string"
        },
        "cursor": {
          "description": "Opaque cursor from a previous page's `next_cursor`.",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "description": "Page size.",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "q": {
          "description": "Case-insensitive substring of the prompt.",
          "type": "string"
        },
        "status": {
          "description": "Only problems in this status.",
          "enum": [
            "draft",
            "live",
            "archived"
          ],
          "type": "string"
        },
        "tag": {
          "description": "Only problems carrying this tag, named by ID, slug or alias (a merged tag stands for the tag it was merged into). An unknown tag is answered 422.",
          "type": "string"
        },
        "type": {
          "description": "Only problems of this type.",
          "enum": [
            "mcq",
            "cloze",
            "open"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "problems_list"
  },
  {
    "description": "Replace a problem's tags\n\nReplaces the set of tags on a problem. Each entry is a tag ID, slug or\nalias; duplicates are ignored. A merged tag resolves to the tag it was\nmerged into. Unknown or retired tags are a 422. Tags attach to the\nproblem, not to a version.\n\nSend the complete desired tag list; omitted tags are removed.",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Problem ID.",
          "type": "string"
        },
        "tags": {
          "description": "Tag IDs, slugs or aliases.",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        }
      },
      "required": [
        "id",
        "tags"
      ],
      "type": "object"
    },
    "name": "problems_setTags"
  },
  {
    "description": "Find similar problems\n\nDuplicate check. Tokenizes the given prompt and answers (lowercase\nwords and numbers) and ranks the caller's non-deleted problems by\ntoken-set Jaccard similarity against each problem's current prompt and\nanswers (choice texts, accepted cloze answers, or the open reference\nanswer). Scores run from 0 to 1; problems sharing no token are never\nreturned. Results are ordered by score, highest first. This is a\nread-only query.\n\nCall this before problems.create with the draft prompt and its answers. A score near 1 means the problem already exists: update or skip it instead of creating a duplicate.",
    "inputSchema": {
      "properties": {
        "answers": {
          "description": "Answer texts (choices, accepted answers, reference answer).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": 5,
          "description": "How many candidates to return at most.",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "min_score": {
          "default": 0,
          "description": "Drop candidates scoring below this.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "prompt": {
          "description": "The prompt text to check.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "prompt"
      ],
      "type": "object"
    },
    "name": "problems_similar"
  },
  {
    "description": "List a problem's versions\n\nReturns every version of the problem, oldest first, with answers.\nOld versions stay readable after an edit.",
    "inputSchema": {
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "problems_versions"
  },
  {
    "description": "Create a quiz\n\nCreates a quiz, `draft` unless `status` says otherwise. `problem_ids`\noptionally sets the initial items in order; each must be a distinct,\nnon-deleted problem of the caller (422 otherwise).",
    "inputSchema": {
      "properties": {
        "description": {
          "maxLength": 2000,
          "type": "string"
        },
        "problem_ids": {
          "description": "Initial items in order.",
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "type": "array"
        },
        "status": {
          "enum": [
            "draft",
            "live",
            "archived"
          ],
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "name": "quizzes_create"
  },
  {
    "description": "Delete a quiz\n\nSoft-deletes the quiz; it no longer appears in reads or lists.\nRequires `If-Match` (412 when stale, 428 when missing).",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Quiz ID.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "quizzes_delete"
  },
  {
    "description": "Get a quiz\n\nReturns the quiz with its items in order.",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Quiz ID.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "quizzes_get"
  },
  {
    "description": "List quizzes\n\nLists the caller's non-deleted quizzes ordered by ID, each with its\nordered items. Without `status`, quizzes of every status are listed.",
    "inputSchema": {
      "properties": {
        "cursor": {
          "description": "Opaque cursor from a previous page's `next_cursor`.",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "description": "Page size.",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "status": {
          "description": "Only quizzes with this status.",
          "enum": [
            "draft",
            "live",
            "archived"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "quizzes_list"
  },
  {
    "description": "Replace a quiz's items\n\nReplaces the quiz's ordered problem list; position follows the order\nof `problem_ids`. Each ID must be a distinct, non-deleted problem of\nthe caller: an unknown ID, another user's problem or a duplicate is a\n422 naming the entry, and nothing changes. Requires `If-Match`\n(412 when stale, 428 when missing).\n\nSend the complete desired problem list in order; omitted problems are removed.",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Quiz ID.",
          "type": "string"
        },
        "problem_ids": {
          "description": "Problem IDs in the desired order; no duplicates.",
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "type": "array"
        }
      },
      "required": [
        "id",
        "problem_ids"
      ],
      "type": "object"
    },
    "name": "quizzes_setItems"
  },
  {
    "description": "Update a quiz\n\nChanges the title, description and/or status. Items are replaced\nthrough `PUT /quizzes/{id}/items`. Requires `If-Match` (412 when\nstale, 428 when missing).",
    "inputSchema": {
      "properties": {
        "description": {
          "maxLength": 2000,
          "type": "string"
        },
        "id": {
          "description": "Quiz ID.",
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "live",
            "archived"
          ],
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "quizzes_update"
  },
  {
    "description": "Get a tag operation\n\nReturns the operation. A proposed operation carries a live `preview`:\nthe problems affected and the resulting tag counts if it were applied\nnow.",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Tag operation ID.",
          "type": "string"
